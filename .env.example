# ---- Database driver: "dataapi" (AWS Aurora via RDS Data API) or "pg" (local Postgres) ----
DB_DRIVER=dataapi

# --- dataapi driver (production / Vercel) ---
# NOTE: Vercel reserves some AWS_* names, so this app uses APP_AWS_* instead.
APP_AWS_REGION=eu-central-1
# Recommended on Vercel: OIDC federation, no stored keys. IAM role trusted by oidc.vercel.com/<team>.
APP_AWS_ROLE_ARN=arn:aws:iam::<account-id>:role/islams-shop-vercel
# Alternative: static IAM user keys (leave empty when using the role)
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
DB_CLUSTER_ARN=arn:aws:rds:eu-central-1:<account-id>:cluster:sdet-lab
DB_SECRET_ARN=arn:aws:secretsmanager:eu-central-1:<account-id>:secret:rds!cluster-...
DB_NAME=postgres

# --- pg driver (local development) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# --- Auth: long random string, e.g. `openssl rand -base64 32` ---
# Required for the pg driver. Optional with dataapi: if unset, the JWT key is derived from the DB secret.
SESSION_SECRET=change-me-to-a-long-random-string
